# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=mtii_user
DB_PASSWORD=replace_with_database_password
DB_NAME=mtii_portal

# Staff sessions
# Allowed SESSION_TTL_HOURS range: 1-24.
SESSION_COOKIE_NAME=mtii_staff_session
SESSION_TTL_HOURS=8

# Application URLs
# Local development:
APP_URL=http://localhost:3000
# Production must set APP_URL to the deployed HTTPS origin.
# Example: APP_URL=https://api.mtiinasarawa.com.ng
PUBLIC_WEBSITE_URL=https://mtiinasarawa.com.ng

# Initial Super Admin bootstrap only.
# These values are used by npm run seed:super-admin and are not
# required for normal application runtime.
SUPER_ADMIN_FIRST_NAME=
SUPER_ADMIN_LAST_NAME=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=